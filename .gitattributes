# The Mac script MUST keep Unix (LF) line endings or bash won't run it.
*.command text eol=lf
*.sh      text eol=lf

# Windows PowerShell is happiest with CRLF.
*.ps1     text eol=crlf

# Everything else: let git normalise text, leave binaries alone.
*.md      text
*.txt     text
*.yml     text eol=lf
